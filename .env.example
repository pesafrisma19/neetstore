# ============================================================
# NEETSHOP FRONTEND — Environment Variables Template
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# URL Backend API
# Development (default jika tidak diset):
# VITE_API_URL=http://localhost:5000/api

# Production — isi dengan URL backend kamu di VPS/Vercel:
VITE_API_URL=https://api.neetshop.com/api

# Google Identity Services (Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudflare Turnstile CAPTCHA (Site Key)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
